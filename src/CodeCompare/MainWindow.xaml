<Window x:Class="CodeCompare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodeCompare.Controls"
        xmlns:infra="clr-namespace:CodeCompare.Infrastructure"
        xmlns:core="clr-namespace:CodeCompare.Core.Comparison;assembly=CodeCompare.Core"
        Title="Code Compare" Width="1440" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:FileSizeConverter x:Key="FileSize" />
        <infra:SignedNumberConverter x:Key="Signed" />
        <infra:BlankZeroConverter x:Key="BlankZero" />
        <infra:DeltaBrushConverter x:Key="DeltaBrush" />
        <infra:EmptyToVisibleConverter x:Key="EmptyToVisible" />
        <infra:InverseBooleanConverter x:Key="Inverse" />

        <Style x:Key="NumberColumn" TargetType="TextBlock" BasedOn="{StaticResource NumberCell}" />
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="HeaderGripper" TargetType="Thumb">
            <Setter Property="Width" Value="6" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact header: the Fluent default reserves too much space for narrow numeric columns. -->
        <Style x:Key="CompactHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderLineBrush}"
                                    BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <Path x:Name="SortArrow" DockPanel.Dock="Right" Width="8" Height="5" Margin="3,0,0,0" Stretch="Fill"
                                          Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Visibility="Collapsed"
                                          Data="M0,1 L1,1 0.5,0 Z" />
                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                                </DockPanel>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource HeaderGripper}" />
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource HeaderGripper}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAEEF2" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                <Setter TargetName="SortArrow" Property="Data" Value="M0,0 L1,0 0.5,1 Z" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="2,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDF4FF" />
                    <Setter Property="Foreground" Value="#1F2328" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="StatusPill" DataType="{x:Type core:FileComparison}">
            <Border x:Name="Pill" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#EAEEF2">
                <TextBlock x:Name="Label" Text="{Binding StatusText}" FontSize="11" Foreground="#424A53" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:FileStatus.Different}">
                    <Setter TargetName="Pill" Property="Background" Value="#FFF1E5" />
                    <Setter TargetName="Label" Property="Foreground" Value="#953800" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:FileStatus.LeftOnly}">
                    <Setter TargetName="Pill" Property="Background" Value="#FFEBE9" />
                    <Setter TargetName="Label" Property="Foreground" Value="#A40E26" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:FileStatus.RightOnly}">
                    <Setter TargetName="Pill" Property="Background" Value="#DAFBE1" />
                    <Setter TargetName="Label" Property="Foreground" Value="#116329" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:FileStatus.Error}">
                    <Setter TargetName="Pill" Property="Background" Value="#F0F0F0" />
                    <Setter TargetName="Label" Property="Foreground" Value="#57606A" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="CompactGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EAEEF2" />
            <Setter Property="CanUserReorderColumns" Value="True" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource CompactHeader}" />
            <Setter Property="CellStyle" Value="{StaticResource CompactCell}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Folder selection ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1" Padding="14,10,14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="Left folder (original)" />
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Padding="12,4" Click="BrowseLeft_Click" />
                    <ComboBox x:Name="LeftBox" IsEditable="True" Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding RecentLeft}" AllowDrop="True" ToolTip="Type a path, pick a recent folder or drop a folder here"
                              PreviewDragOver="Path_PreviewDragOver" PreviewDrop="LeftPath_PreviewDrop" />
                </DockPanel>

                <Button Grid.Column="1" Content="⇄" FontSize="16" Padding="10,2" Margin="10,0" VerticalAlignment="Bottom"
                        ToolTip="Swap left and right" Click="Swap_Click" />

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="Right folder (modified)" />
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Padding="12,4" Click="BrowseRight_Click" />
                    <ComboBox x:Name="RightBox" IsEditable="True" Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding RecentRight}" AllowDrop="True" ToolTip="Type a path, pick a recent folder or drop a folder here"
                              PreviewDragOver="Path_PreviewDragOver" PreviewDrop="RightPath_PreviewDrop" />
                </DockPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                    <Button x:Name="CompareButton" Content="Compare" Style="{DynamicResource AccentButtonStyle}"
                            Padding="22,5" FontWeight="SemiBold" Click="Compare_Click" ToolTip="Compare the two folders (F5)"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Inverse}}" />
                    <Button Content="Cancel" Margin="6,0,0,0" Padding="12,5" Click="Cancel_Click" ToolTip="Stop the comparison (Esc)"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="ExportButton" Content="Export ▾" Margin="6,0,0,0" Padding="12,5" Click="Export_Click"
                            IsEnabled="{Binding HasResults}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="HTML report (summary, statistics and diffs)…" Click="ExportHtml_Click" />
                                <MenuItem Header="File list as CSV (opens in Excel)…" Click="ExportCsv_Click" />
                                <MenuItem Header="Unified diff / patch file…" Click="ExportPatch_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="220" Height="6" Margin="12,0,0,0" VerticalAlignment="Center"
                             Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                           Text="F5 compare · F7 / Shift+F7 next/previous change · F8 / Shift+F8 next/previous changed file · Ctrl+F search" />
                <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ===== Body ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="300" MinWidth="230" MaxWidth="600" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Options panel -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,0,10,14">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="FILE TYPES" />
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource LinkButton}" Content="All" Click="SelectAll_Click" />
                            <Button Style="{StaticResource LinkButton}" Content="None" Margin="10,0,0,0" Click="SelectNone_Click" />
                            <Button Style="{StaticResource LinkButton}" Content="Defaults" Margin="10,0,0,0" Click="SelectDefaults_Click" />
                        </StackPanel>
                        <TextBlock Text="{Binding ExtensionSummary}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Add" Margin="6,0,0,0" Padding="12,4" Click="AddExtension_Click" />
                        <Grid>
                            <TextBox x:Name="NewExtensionBox" Text="{Binding NewExtension, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewExtension_KeyDown"
                                     ToolTip="Add your own extensions, e.g. .tpl .liquid" />
                            <TextBlock Text="Add extensions, e.g. .tpl .liquid" IsHitTestVisible="False" Foreground="#8C959F" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding Text, ElementName=NewExtensionBox, Converter={StaticResource EmptyToVisible}}" />
                        </Grid>
                    </DockPanel>

                    <CheckBox Content="Include all files (ignore file types)" IsChecked="{Binding IncludeAllFiles}" Margin="0,0,0,6" />

                    <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1" CornerRadius="6" Height="330"
                            IsEnabled="{Binding IncludeAllFiles, Converter={StaticResource Inverse}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,4,6">
                            <ItemsControl ItemsSource="{Binding ExtensionsView}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,8,4,2">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="toggle" FontSize="11"
                                                            Tag="{Binding Name}" Click="ToggleCategory_Click" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}" ToolTip="{Binding ToolTip}"
                                                  Width="84" MinWidth="0" MinHeight="0" FontSize="12" Margin="0,1" Padding="4,0,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="COMPARISON" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Whitespace" />
                    <ComboBox SelectedIndex="{Binding WhitespaceIndex}" Margin="0,0,0,8">
                        <ComboBoxItem Content="Compare exactly" />
                        <ComboBoxItem Content="Ignore leading / trailing whitespace" />
                        <ComboBoxItem Content="Ignore all whitespace" />
                    </ComboBox>
                    <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}" />
                    <CheckBox Content="Ignore blank lines" IsChecked="{Binding IgnoreBlankLines}" />
                    <CheckBox Content="Include subfolders" IsChecked="{Binding Recursive}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="EXCLUDE" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Folders (semicolon-separated, wildcards allowed)" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ExcludedFolders, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Files" />
                    <TextBox Text="{Binding ExcludedFiles, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False" />
                    <Button Style="{StaticResource LinkButton}" Content="Restore default exclusions" Margin="0,6,0,0" HorizontalAlignment="Left" Click="RestoreExclusions_Click" />
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderLineBrush}" Width="1" ResizeBehavior="PreviousAndNext" />

            <!-- Results -->
            <TabControl Grid.Column="2" Margin="0,4,0,0" BorderThickness="0">
                <TabItem Header="Files">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="FilesRow" Height="2*" MinHeight="120" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="3*" MinHeight="150" />
                        </Grid.RowDefinitions>

                        <!-- Filter bar -->
                        <DockPanel Grid.Row="0" Margin="10,6,10,6">
                            <Grid DockPanel.Dock="Right" Width="280">
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                <TextBlock Text="Filter by path or language (Ctrl+F)" IsHitTestVisible="False" Foreground="#8C959F" FontSize="12"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}" />
                            </Grid>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}" />
                                <CheckBox Content="{Binding DifferentLabel}" IsChecked="{Binding ShowDifferent}" Margin="0,0,14,0" />
                                <CheckBox Content="{Binding LeftOnlyLabel}" IsChecked="{Binding ShowLeftOnly}" Margin="0,0,14,0" />
                                <CheckBox Content="{Binding RightOnlyLabel}" IsChecked="{Binding ShowRightOnly}" Margin="0,0,14,0" />
                                <CheckBox Content="{Binding IdenticalLabel}" IsChecked="{Binding ShowIdentical}" Margin="0,0,14,0" />
                                <TextBlock Text="{Binding VisibleCountText}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            </WrapPanel>
                        </DockPanel>

                        <!-- File list -->
                        <DataGrid x:Name="FilesGrid" Grid.Row="1" Style="{StaticResource CompactGrid}"
                                  ItemsSource="{Binding FilesView}" SelectionMode="Extended"
                                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  SelectionChanged="FilesGrid_SelectionChanged" MouseDoubleClick="FilesGrid_MouseDoubleClick"
                                  BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,1,0,1">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open diff in new window" Click="OpenDiffWindow_Click" FontWeight="SemiBold" />
                                    <Separator />
                                    <MenuItem Header="Open left file" Click="OpenLeftFile_Click" />
                                    <MenuItem Header="Open right file" Click="OpenRightFile_Click" />
                                    <MenuItem Header="Show left file in Explorer" Click="ExploreLeftFile_Click" />
                                    <MenuItem Header="Show right file in Explorer" Click="ExploreRightFile_Click" />
                                    <Separator />
                                    <MenuItem Header="Copy relative path" Click="CopyRelativePath_Click" />
                                    <MenuItem Header="Copy full paths" Click="CopyFullPaths_Click" />
                                    <Separator />
                                    <MenuItem Header="Copy left → right (overwrite right)…" Click="CopyLeftToRight_Click" />
                                    <MenuItem Header="Copy right → left (overwrite left)…" Click="CopyRightToLeft_Click" />
                                    <Separator />
                                    <MenuItem Header="Re-compare selected" Click="Recompare_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" SortMemberPath="Status" CellTemplate="{StaticResource StatusPill}" Width="108" MinWidth="108" />
                                <DataGridTemplateColumn Header="Path" SortMemberPath="RelativePath" Width="*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type core:FileComparison}">
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}" Margin="4,0">
                                                <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="96" MinWidth="96" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Lines L" Binding="{Binding LeftLines, StringFormat=N0}" SortMemberPath="LeftLines" Width="72" MinWidth="72" ElementStyle="{StaticResource NumberColumn}" />
                                <DataGridTextColumn Header="Lines R" Binding="{Binding RightLines, StringFormat=N0}" SortMemberPath="RightLines" Width="72" MinWidth="72" ElementStyle="{StaticResource NumberColumn}" />
                                <DataGridTextColumn Header="Code L" Binding="{Binding LeftCode, StringFormat=N0}" SortMemberPath="LeftCode" Width="72" MinWidth="72" ElementStyle="{StaticResource NumberColumn}" />
                                <DataGridTextColumn Header="Code R" Binding="{Binding RightCode, StringFormat=N0}" SortMemberPath="RightCode" Width="72" MinWidth="72" ElementStyle="{StaticResource NumberColumn}" />
                                <DataGridTemplateColumn Header="Δ Code" SortMemberPath="CodeDelta" Width="72" MinWidth="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type core:FileComparison}">
                                            <TextBlock Style="{StaticResource NumberCell}" Text="{Binding CodeDelta, Converter={StaticResource Signed}}"
                                                       Foreground="{Binding CodeDelta, Converter={StaticResource DeltaBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Added" SortMemberPath="Added" Width="72" MinWidth="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type core:FileComparison}">
                                            <TextBlock Style="{StaticResource NumberCell}" Foreground="{StaticResource AddedTextBrush}"
                                                       Text="{Binding Added, Converter={StaticResource BlankZero}, ConverterParameter=+}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Deleted" SortMemberPath="Deleted" Width="74" MinWidth="74">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type core:FileComparison}">
                                            <TextBlock Style="{StaticResource NumberCell}" Foreground="{StaticResource DeletedTextBrush}"
                                                       Text="{Binding Deleted, Converter={StaticResource BlankZero}, ConverterParameter=−}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Modified" SortMemberPath="Modified" Width="78" MinWidth="78">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type core:FileComparison}">
                                            <TextBlock Style="{StaticResource NumberCell}" Foreground="{StaticResource ModifiedTextBrush}"
                                                       Text="{Binding Modified, Converter={StaticResource BlankZero}, ConverterParameter=~}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Size L" Binding="{Binding LeftSize, Converter={StaticResource FileSize}}" SortMemberPath="LeftSize" Width="72" MinWidth="72" ElementStyle="{StaticResource NumberColumn}" />
                                <DataGridTextColumn Header="Size R" Binding="{Binding RightSize, Converter={StaticResource FileSize}}" SortMemberPath="RightSize" Width="72" MinWidth="72" ElementStyle="{StaticResource NumberColumn}" />
                                <DataGridTextColumn Header="Date L" Binding="{Binding LeftModified, StringFormat=yyyy-MM-dd HH:mm}" SortMemberPath="LeftModified" Width="122" MinWidth="122" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Date R" Binding="{Binding RightModified, StringFormat=yyyy-MM-dd HH:mm}" SortMemberPath="RightModified" Width="122" MinWidth="122" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="320" MinWidth="320" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="14" IsHitTestVisible="False"
                                   Text="Pick a left and right folder, choose the file types on the left, then press Compare."
                                   x:Name="EmptyHint" />

                        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource HeaderBrush}"
                                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" />

                        <Border Grid.Row="3" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,1,0,0">
                            <controls:DiffViewer x:Name="Viewer" PopOutRequested="Viewer_PopOutRequested" />
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Statistics">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18,8,18,18">
                            <TextBlock Text="Files" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10" />
                            <WrapPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Files compared" />
                                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding Summary.Total, StringFormat=N0}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Different" />
                                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding Summary.Different, StringFormat=N0}" Foreground="#953800" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Only in left" />
                                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding Summary.LeftOnly, StringFormat=N0}" Foreground="{StaticResource DeletedTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Only in right" />
                                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding Summary.RightOnly, StringFormat=N0}" Foreground="{StaticResource AddedTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Identical" />
                                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding Summary.Identical, StringFormat=N0}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Errors" />
                                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding Summary.Errors, StringFormat=N0}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="Line changes" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,10" />
                            <WrapPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Lines added" />
                                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding Summary.Added, StringFormat=+{0:N0}}" Foreground="{StaticResource AddedTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Lines deleted" />
                                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding Summary.Deleted, StringFormat=−{0:N0}}" Foreground="{StaticResource DeletedTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Lines modified" />
                                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding Summary.Modified, StringFormat=~{0:N0}}" Foreground="{StaticResource ModifiedTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Net change in code lines" />
                                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding Summary.CodeDelta, Converter={StaticResource Signed}}"
                                                   Foreground="{Binding Summary.CodeDelta, Converter={StaticResource DeltaBrush}}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="Lines of code" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,10" />
                            <DataGrid Style="{StaticResource CompactGrid}" ItemsSource="{Binding LocRows}" HorizontalAlignment="Left" Width="520"
                                      CanUserSortColumns="False" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="" Binding="{Binding Label}" Width="*" FontWeight="SemiBold" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Left" Binding="{Binding Left, StringFormat=N0}" Width="110" MinWidth="110" ElementStyle="{StaticResource NumberColumn}" />
                                    <DataGridTextColumn Header="Right" Binding="{Binding Right, StringFormat=N0}" Width="110" MinWidth="110" ElementStyle="{StaticResource NumberColumn}" />
                                    <DataGridTemplateColumn Header="Change" Width="110" MinWidth="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource NumberCell}" Text="{Binding Delta, Converter={StaticResource Signed}}"
                                                           Foreground="{Binding Delta, Converter={StaticResource DeltaBrush}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="By language" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,10" />
                            <DataGrid Style="{StaticResource CompactGrid}" ItemsSource="{Binding Summary.Languages}"
                                      BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="130" MinWidth="130" FontWeight="SemiBold" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Extensions" Binding="{Binding Extensions}" Width="*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Files L" Binding="{Binding LeftFiles, StringFormat=N0}" Width="64" MinWidth="64" ElementStyle="{StaticResource NumberColumn}" />
                                    <DataGridTextColumn Header="Files R" Binding="{Binding RightFiles, StringFormat=N0}" Width="64" MinWidth="64" ElementStyle="{StaticResource NumberColumn}" />
                                    <DataGridTextColumn Header="Code L" Binding="{Binding Left.Code, StringFormat=N0}" SortMemberPath="Left.Code" Width="80" MinWidth="80" ElementStyle="{StaticResource NumberColumn}" />
                                    <DataGridTextColumn Header="Code R" Binding="{Binding Right.Code, StringFormat=N0}" SortMemberPath="Right.Code" Width="80" MinWidth="80" ElementStyle="{StaticResource NumberColumn}" />
                                    <DataGridTemplateColumn Header="Δ Code" SortMemberPath="CodeDelta" Width="76" MinWidth="76">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource NumberCell}" Text="{Binding CodeDelta, Converter={StaticResource Signed}}"
                                                           Foreground="{Binding CodeDelta, Converter={StaticResource DeltaBrush}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Comments L" Binding="{Binding Left.Comment, StringFormat=N0}" SortMemberPath="Left.Comment" Width="96" MinWidth="96" ElementStyle="{StaticResource NumberColumn}" />
                                    <DataGridTextColumn Header="Comments R" Binding="{Binding Right.Comment, StringFormat=N0}" SortMemberPath="Right.Comment" Width="96" MinWidth="96" ElementStyle="{StaticResource NumberColumn}" />
                                    <DataGridTextColumn Header="Blank L" Binding="{Binding Left.Blank, StringFormat=N0}" SortMemberPath="Left.Blank" Width="70" MinWidth="70" ElementStyle="{StaticResource NumberColumn}" />
                                    <DataGridTextColumn Header="Blank R" Binding="{Binding Right.Blank, StringFormat=N0}" SortMemberPath="Right.Blank" Width="70" MinWidth="70" ElementStyle="{StaticResource NumberColumn}" />
                                    <DataGridTextColumn Header="+ Added" Binding="{Binding Added, StringFormat=N0}" Width="70" MinWidth="70" ElementStyle="{StaticResource NumberColumn}" />
                                    <DataGridTextColumn Header="− Deleted" Binding="{Binding Deleted, StringFormat=N0}" Width="74" MinWidth="74" ElementStyle="{StaticResource NumberColumn}" />
                                    <DataGridTextColumn Header="~ Modified" Binding="{Binding Modified, StringFormat=N0}" Width="78" MinWidth="78" ElementStyle="{StaticResource NumberColumn}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
